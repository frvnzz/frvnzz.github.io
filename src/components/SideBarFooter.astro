{/* Fades the menu out as it scrolls behind the pinned social links. */}
<div
  class="block sticky pointer-events-none bottom-10 bg-base-200 h-12 mask-[linear-gradient(transparent,#000000)]"
>
</div>

<nav
  class="px-4 pb-5 pt-1 flex self-center justify-center sticky bottom-0 bg-base-200"
  aria-label="Social links"
>
  {
    socials.map(({ label, href, viewBox, paths, evenOdd }) => {
      const external = !href.startsWith("mailto:");
      return (
        <a
          href={href}
          class="mx-3"
          aria-label={label}
          title={label}
          target={external ? "_blank" : undefined}
          rel={external ? "noopener noreferrer" : undefined}
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox={viewBox}
            class="fill-current"
            aria-hidden="true"
          >
            {paths.map((d) => (
              <path
                d={d}
                fill-rule={evenOdd ? "evenodd" : undefined}
                clip-rule={evenOdd ? "evenodd" : undefined}
              />
            ))}
          </svg>
        </a>
      );
    })
  }
</nav>

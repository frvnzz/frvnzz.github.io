---
interface Props {
  title: string;
  subtitle: string;
}

const { title, subtitle } = Astro.props;
const hasDetails = Astro.slots.has("default");
---

<div class="flex">
  <div class="education__time" aria-hidden="true">
    <span class="w-4 h-4 bg-primary block rounded-full mt-1"></span>
    <span
      class="education__line bg-primary block h-full w-0.5 translate-x-1.75"
    ></span>
  </div>
  <div class="px-5">
    <h3 class="font-semibold mb-1">{title}</h3>
    <span class="font-light text-sm">{subtitle}</span>
    {
      hasDetails && (
        <p class="my-2 text-justify">
          <slot />
        </p>
      )
    }
  </div>
</div>

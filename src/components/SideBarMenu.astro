---
interface Props {
  sideBarActiveItemID?: string;
}

const { sideBarActiveItemID } = Astro.props;

// Highlight for the current page. For primary colour, use `active` instead.
const activeClass = "bg-base-300";

const links = [
  { id: "home", label: "Home", href: "/" },
  { id: "projects", label: "Projects", href: "/projects" },
  { id: "cv", label: "CV", href: "/cv" },
];
---

<nav class="grow shrink overflow-y-auto" aria-label="Main">
  <ul class="menu menu-md w-full">
    {
      links.map(({ id, label, href }) => {
        const isActive = sideBarActiveItemID === id;
        return (
          <li class="mb-1">
            <a
              href={href}
              class:list={["py-3 text-base", isActive && activeClass]}
              aria-current={isActive ? "page" : undefined}
            >
              {label}
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>

---
import BaseLayout from "../layouts/BaseLayout.astro";

const skills = [
  {
    group: "Programming Languages",
    items: ["C#", "JavaScript", "TypeScript", "Kotlin"],
  },
  {
    group: "Tools & Technologies",
    items: [
      "React",
      "Node.js",
      "Next.js",
      "Astro",
      "Room Database",
      "Unity",
      "Tailwind CSS",
      "npm/pnpm",
      "Yarn",
      "Homebrew",
    ],
  },
  {
    group: "Version Control & CI/CD",
    items: ["Git", "GitHub Actions", "GitLab Pipelines"],
  },
  {
    group: "Design",
    items: [
      "Procreate",
      "Figma",
      "Blender",
      "Adobe Creative Suite",
      "Affinity Suite",
    ],
  },
  {
    group: "General",
    items: [
      "Agile Development",
      "Kanban",
      "UI/UX Research",
      "Responsive Web Design",
      "Accessibility (a11y) Best Practices",
      "User Interface Design",
    ],
  },
];
---

<BaseLayout sideBarActiveItemID="home">
  <div class="pb-12 mt-5">
    <p class="text-xl py-1">Hi 👋</p>
    <h1 class="text-5xl font-bold">I'm Franz-Aurel Huber</h1>
    <p class="text-3xl py-3 font-bold">Student at UAS St. Pölten</p>
    <p class="py-2 text-lg">
      I like <b>frontend development</b> and <b>UI/UX design</b>. I am
      passionate about creating seamless digital experiences and I love cars. I
      started programming in late 2023 as part of my studies and I aim to
      improve ever since.
    </p>
    <div class="py-2 text-lg">
      <a
        href="https://github.com/frvnzz"
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-outline">Check out my GitHub</a
      >
    </div>
  </div>

  <section class="mt-4">
    <h2 class="text-3xl font-bold mb-3">Skills &lt;/&gt;</h2>

    {
      skills.map(({ group, items }) => (
        <>
          <h3 class="text-xl font-bold mt-5">{group}</h3>
          <ul class="flex flex-wrap gap-3 mt-2">
            {items.map((item) => (
              <li class="px-3 py-1 rounded-full border">{item}</li>
            ))}
          </ul>
        </>
      ))
    }
  </section>
</BaseLayout>
